# ═══════════════════════════════════════════════════════════════════
#  DUMUZI Luxury Confections — Complete .env Template
#
#  FOR RENDER DEPLOYMENT:
#    Set all these as Environment Variables in your Render dashboard
#    (Settings → Environment → Add Environment Variable)
#
#  FOR LOCAL DEV:
#    Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════════


# ── SERVER ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# Render sets this automatically — no need to add manually on Render


# ── POSTGRESQL DATABASE (Render) ────────────────────────────────────
# Render gives you this URL automatically when you create a PostgreSQL database.
# It looks like: postgresql://user:password@host:5432/dbname
#
# In Render Dashboard:
#   1. Go to your Web Service → Environment tab
#   2. You'll see DATABASE_URL already added (if you linked a Render DB)
#   OR copy it from: your PostgreSQL service → Info → Internal Database URL
#
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME


# ── ADMIN AUTHENTICATION ────────────────────────────────────────────
# Run locally: node scripts/generateSecrets.js
# Then paste the output here / in Render environment variables
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE


# ── JWT SECRET ──────────────────────────────────────────────────────
# Run locally: node scripts/generateSecrets.js
# Then paste the output here / in Render environment variables
JWT_SECRET=PASTE_LONG_RANDOM_SECRET_HERE


# ── CLOUDINARY (Image Uploads) ──────────────────────────────────────
# Sign up at cloudinary.com → Dashboard → copy these 3 values
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# ── PAYU (Payments) ─────────────────────────────────────────────────
# PayU Dashboard → Developers → API Keys → copy "Key" and "Salt".
# The SALT is a signing secret: never commit it, never expose it to the browser.
PAYU_MERCHANT_KEY=your_payu_key
PAYU_MERCHANT_SALT=your_payu_salt

# "test"  → posts to https://test.payu.in/_payment   (no real money moves)
# "production" → posts to https://secure.payu.in/_payment (LIVE charges)
# Anything other than the exact word "production" is treated as test.
PAYU_MODE=test

# Absolute, public URL of THIS backend. PayU posts the payment result to
# <PUBLIC_API_URL>/api/payments/payu/callback, so it must be reachable from
# the internet. Falls back to the incoming request's host if unset.
PUBLIC_API_URL=https://dumuzi-backend.onrender.com

# Where the shopper is sent after PayU redirects back (your storefront).
FRONTEND_URL=https://dumuzi.com


# ── META CONVERSIONS API (server-side Purchase) ─────────────────────
# Sends Purchase from the server, deduplicated against the browser Pixel's
# copy by event_id purchase_<orderId>. Leave the token unset and it's simply
# skipped — checkout and payments never depend on it.
META_PIXEL_ID=3602765189880157

# Events Manager → your Pixel → Settings → Conversions API → Generate access token.
# SECRET: set it only in Render's environment, never in the frontend or in git.
META_ACCESS_TOKEN=

# Optional. Defaults to the version pinned in services/metaConversionsApi.js.
# META_GRAPH_API_VERSION=v26.0

# Testing only: the code shown in Events Manager → Test Events. While set,
# every Purchase goes to Test Events instead of counting as a real conversion,
# so remove it as soon as testing is done.
META_TEST_EVENT_CODE=


# ── LOCAL DEV ONLY (MySQL fallback — ignored if DATABASE_URL is set) ─
# Only needed if running locally without Render PostgreSQL
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=dumuzi_local
# DB_USER=root
# DB_PASSWORD=your_local_password
# DB_SSL=false
